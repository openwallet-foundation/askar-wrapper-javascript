{
  "name": "@openwallet-foundation/askar-wrapper-javascript",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/openwallet-foundation/askar-wrapper-javascript"
  },
  "engines": {
    "node": ">= 22.12"
  },
  "scripts": {
    "style:check": "biome check --unsafe .",
    "style:fix": "pnpm style:check --write",
    "types:check": "pnpm -r types:check",
    "build": "pnpm -r build",
    "test": "vitest",
    "test:android": "pnpm --filter askar-react-native-example test:android",
    "test:ios": "pnpm --filter askar-react-native-example test:ios",
    "test:android:device": "pnpm --filter askar-react-native-example test:android:device",
    "test:ios:device": "pnpm --filter askar-react-native-example test:ios:device",
    "release": "pnpm build && pnpm changeset publish --no-git-tag",
    "changeset-version": "pnpm changeset version && pnpm style:fix"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.15.0"
}
